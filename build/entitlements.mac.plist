<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS hardened-runtime entitlements (Phase 20F). Minimal set for an Electron
     app that spawns the Zornux compiler subprocess; expand only if a real feature
     needs it. Applied during notarized signing on a macOS CI runner. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 / JIT needs writable+executable pages. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allow spawning helper processes (the zornux CLI) with the app's env. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Read files the user opens. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
