# A rich, valid Zornux file exercising every outline symbol kind.
import math
import strings from "std/strings"
import Utils as U
import Helpers showing trim, split

create PI = 3.14159
create counter = 0

type Point

record User
  has name as text required
end

class Account
  has balance as number

  function deposit with amount
    create new_balance = balance + amount
  end
end

database AppDb
  provider postgres
  connection "host=localhost dbname=myapp"
  table Users from User
  table Accounts from Account
  migrate on open
end

function main
  create total = 0
  if true
    create inner = 1
  end
end
